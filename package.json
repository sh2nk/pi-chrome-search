{
  "name": "pi-chrome-search",
  "version": "0.1.0",
  "description": "Free, keyless web search through the user's own visible Chrome (Google, DuckDuckGo, Yandex) for pi",
  "type": "module",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=15000 \"tests/unit/**/*.test.ts\"",
    "test:live": "PI_CHROME_LIVE=1 node --test \"tests/live/**/*.test.ts\"",
    "bench": "node bench/run.ts",
    "audit": "node scripts/audit.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "linkedom": "^0.18.15",
    "typebox": "^1.3.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "pi-package"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ]
}

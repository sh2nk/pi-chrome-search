{
  "name": "pi-chrome-search",
  "version": "0.1.1",
  "description": "Free, keyless web search through the user's own visible Chrome (Google, DuckDuckGo, Yandex) for pi",
  "type": "module",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && node scripts/audit.mjs",
    "test": "node --test --test-timeout=15000 \"tests/unit/**/*.test.ts\"",
    "test:live": "PI_CHROME_LIVE=1 node --test \"tests/live/**/*.test.ts\"",
    "audit": "node scripts/audit.mjs",
    "gen-config-doc": "node scripts/gen-config-doc.mjs",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "linkedom": "^0.18.15",
    "typebox": "^1.3.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "pi-package",
    "chrome",
    "cdp",
    "web-search",
    "google",
    "duckduckgo",
    "yandex"
  ],
  "files": [
    "index.ts",
    "src",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sh2nk/pi-chrome-search.git"
  },
  "bugs": {
    "url": "https://github.com/sh2nk/pi-chrome-search/issues"
  },
  "homepage": "https://github.com/sh2nk/pi-chrome-search#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

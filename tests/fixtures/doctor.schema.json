{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pi-chrome-search.local/schemas/doctor.schema.json",
  "title": "pi-chrome-search doctor report",
  "description": "Shape of `node src/cli/doctor.ts --json` (SPEC S6.3, A5). Draft-07 subset: type arrays, const, enum, required, properties, additionalProperties, items, minItems, minimum, maximum, minLength. No $ref and no remote resolution: the test validates with a hand-rolled validator and no dependency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "extension",
    "config",
    "cdp",
    "cache",
    "artifacts",
    "engines",
    "verdict"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "minLength": 20
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "node"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "focus", "humanize", "panel", "follow", "idleMs", "debug"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "focus": { "enum": ["session", "always", "never"] },
        "humanize": { "enum": ["auto", "always", "typing"] },
        "panel": { "type": "boolean" },
        "follow": { "enum": ["work", "anchor", "never"] },
        "idleMs": { "type": "integer", "minimum": 0 },
        "debug": { "type": "boolean" }
      }
    },
    "cdp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "endpoint", "browser", "webdriver", "windowId", "windowDegraded", "lock"],
      "properties": {
        "status": { "enum": ["ok", "unavailable", "busy", "error", "awaiting_allow"] },
        "endpoint": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["port", "wsUrl", "source"],
          "properties": {
            "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "wsUrl": { "type": "string", "minLength": 1 },
            "source": { "enum": ["env-ws", "env-ports", "devtools-active-port", "port-scan"] },
            "profileDir": { "type": "string", "minLength": 1 }
          }
        },
        "browser": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["product", "protocolVersion"],
          "properties": {
            "product": { "type": "string" },
            "protocolVersion": { "type": "string" }
          }
        },
        "webdriver": { "type": ["boolean", "null"] },
        "windowId": { "type": ["integer", "null"] },
        "windowDegraded": { "type": "boolean" },
        "lock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["locked", "path", "owner"],
          "properties": {
            "locked": { "type": "boolean" },
            "path": { "type": "string", "minLength": 1 },
            "owner": { "enum": ["none", "self", "other"] },
            "pid": { "type": "integer", "minimum": 1 }
          }
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "stage", "hint"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "stage": { "type": "string", "minLength": 1 },
            "hint": { "type": "string", "minLength": 1 },
            "message": { "type": "string" }
          }
        }
      }
    },
    "cache": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": { "type": "integer", "minimum": 0 }
      }
    },
    "artifacts": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["dir", "bytes"],
      "properties": {
        "dir": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "engines": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "enabled", "verdict"],
        "properties": {
          "id": { "enum": ["google", "duckduckgo", "yandex"] },
          "enabled": { "type": "boolean" },
          "verdict": {
            "enum": ["ok", "wall", "layout_changed", "blocked", "unavailable", "skipped"]
          },
          "note": { "type": "string" },
          "probe": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ms", "results", "ai"],
            "properties": {
              "ms": { "type": "integer", "minimum": 0 },
              "results": { "type": "integer", "minimum": 0 },
              "ai": { "type": "boolean" },
              "wall": { "enum": ["captcha", "consent", "sorry", "blocked"] },
              "canaries": {
                "type": "object",
                "additionalProperties": { "type": "integer", "minimum": 0 }
              },
              "error": {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "stage", "hint"],
                "properties": {
                  "code": { "type": "string", "minLength": 1 },
                  "stage": { "type": "string", "minLength": 1 },
                  "hint": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "verdict": { "enum": ["ok", "degraded", "blocked"] }
  }
}
